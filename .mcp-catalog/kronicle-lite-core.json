        "description": "Create or re-put a whole Markdown document by slug. Use this to write a new document or a full new version of one; to change one block, use supersede_block. A re-put replaces the document: unchanged blocks keep their ids, changed blocks are replaced (superseded) and dropped ones tombstoned, and the document reads the new text from then on. The old text stays on the chain (orient shows it as retractions) and receipts for the old blocks then verify as SUPERSEDED or TOMBSTONED. bind_git with source_path ties the document to that file's git blob (verify reports STALE_SOURCE when the file changes). Refuses text holding a secret (API key, token, private key, connection string): the chain cannot forget it. expect_version refuses a stale write. Retries: with idempotency_key a retry returns the first result (replayed: true) and writes nothing; without one, a retry can append another revision.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "actor_id": {
              "description": "Your agent id (default: server --actor). Cursors are bound to it.",
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            "bind_git": {
              "default": false,
              "description": "Pin the document to source_path's git blob (needs source_path).",
              "type": "boolean"
            },
            "cursor": {
              "description": "Your latest cursor (for the stale-write advisory).",
              "maxLength": 8192,
              "type": "string"
            },
            "expect_version": {
              "description": "The document revision you last read (0 = must not exist yet). If it has changed, the write is refused with version_conflict and current_version; nothing is written.",
              "minimum": 0,
              "type": "integer"
            },
            "idempotency_key": {
              "description": "Retry key: the same put returns the first result (replayed: true); other arguments under it are refused.",
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            "markdown": {
              "description": "The whole document as Markdown; it replaces the current text.",
              "maxLength": 2000000,
              "type": "string"
            },
            "redact_secrets": {
              "default": false,
              "description": "Store a redacted copy instead of refusing a detected secret.",
              "type": "boolean"
            },
            "slug": {
              "description": "name or namespace/Path (finding/G-2); max 128",
